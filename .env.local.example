# Copy this file to .env.local and fill real secret values
# Do NOT commit .env.local with real secrets to git

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Generative AI
GOOGLE_GENERATIVE_AI_API_KEY=ya29.your_google_api_key_here

# Optional: base URL for internal calls (used in some environments)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
